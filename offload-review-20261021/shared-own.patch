@@ -21,6 +21,8 @@ from megatron.core.pipeline_parallel.fine_grained_activation_offload import (
     OffloadTensorPool,
     PipelineOffloadManager,
 )
+from megatron.core.pipeline_parallel.schedules import get_forward_backward_func
+from megatron.core.process_groups_config import ProcessGroupCollection
 from megatron.core.tensor_parallel.random import model_parallel_cuda_manual_seed
 from megatron.core.transformer.enums import AttnBackend
 from megatron.core.transformer.moe.fused_a2a import reset_hybrid_ep_buffer
@@ -195,6 +197,111 @@ def _make_warmup_chunk(groups: List["OffloadTensorGroup"]) -> ChunkOffloadHandle
     return handler
 
 
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="CUDA is required for offloading.")
+@pytest.mark.parametrize("fraction", [0.0, 1.0])
+def test_offload_after_evaluation_with_growing_sequences(monkeypatch, fraction):
+    """Exercise evaluation, warmup and changing tensor sizes through the native GPT schedule."""
+    Utils.initialize_model_parallel()
+    off_interface.reset_instance()
+    try:
+        groups = ProcessGroupCollection.use_mpu_process_groups()
+        snapshots = []
+        transfers = []
+        original_offload = ChunkOffloadHandler.offload
+
+        def record_transfer(handler, *args, **kwargs):
+            transfers.append(handler.is_warmup)
+            return original_offload(handler, *args, **kwargs)
+
+        monkeypatch.setattr(ChunkOffloadHandler, "offload", record_transfer)
+        for enabled in (False, True):
+            config = TransformerConfig(
+                num_layers=4,
+                hidden_size=128,
+                num_attention_heads=4,
+                use_cpu_initialization=True,
+                attention_backend=AttnBackend.unfused,
+                attention_dropout=0.0,
+                hidden_dropout=0.0,
+                bf16=True,
+                fine_grained_activation_offloading=enabled,
+                offload_modules=["core_attn", "attn_proj"] if enabled else [],
+                activation_offload_fraction=fraction,
+                min_offloaded_tensor_size=65536,
+            )
+            torch.manual_seed(31)
+            model_parallel_cuda_manual_seed(31)
+            model = (
+                GPTModel(
+                    config=config,
+                    transformer_layer_spec=get_gpt_layer_with_transformer_engine_spec(),
+                    vocab_size=256,
+                    max_sequence_length=128,
+                )
+                .bfloat16()
+                .cuda()
+            )
+
+            def forward_step(batches, model):
+                tokens, positions, mask = next(batches)
+                output = model(tokens, positions, mask)
+
+                def loss_func(logits):
+                    loss = logits.float().square().mean()
+                    return loss, {"loss": loss.detach().clone()}
+
+                return output, loss_func
+
+            results = []
+            for forward_only, seq_length in ((True, 8), (False, 8), (False, 128), (False, 64)):
+                model.train(not forward_only)
+                model.zero_grad(set_to_none=True)
+                inputs = _make_gpt_inputs(
+                    seq_length=seq_length, micro_batch_size=1, device=torch.device("cuda")
+                )
+                inputs[2].copy_(torch.triu(torch.ones_like(inputs[2]), diagonal=1))
+                with torch.no_grad() if forward_only else nullcontext():
+                    losses = get_forward_backward_func()(
+                        forward_step_func=forward_step,
+                        data_iterator=iter([inputs] * 2),
+                        model=model,
+                        num_microbatches=2,
+                        seq_length=seq_length,
+                        micro_batch_size=1,
+                        forward_only=forward_only,
+                        pg_collection=groups,
+                    )
+                torch.cuda.synchronize()
+                results.append(
+                    (
+                        [item["loss"].cpu() for item in losses],
+                        {
+                            name: p.grad.cpu().clone()
+                            for name, p in model.named_parameters()
+                            if p.grad is not None
+                        },
+                    )
+                )
+                if enabled:
+                    manager = PipelineOffloadManager.get_instance()
+                    assert manager._is_warmup == forward_only
+                    assert len(manager._cached_chunks_forward) == (0 if forward_only else 2)
+                    if not forward_only:
+                        assert all(
+                            len(chunk.offload_groups) == 8
+                            for chunk in manager._cached_chunks_forward
+                        )
+            snapshots.append(results)
+            del model
+        torch.testing.assert_close(snapshots[1], snapshots[0], rtol=0, atol=0)
+        assert bool(transfers) == (fraction > 0)
+        assert not any(transfers), "The tiny warmup must not copy eligible tensors."
+    finally:
+        torch.cuda.synchronize()
+        off_interface.reset_instance()
+        Utils.destroy_model_parallel()
+
+
 def _run_post_warmup_callback(chunk: ChunkOffloadHandler) -> None:
     """Drive post_warmup_callback over a single hand-built chunk."""
     manager = PipelineOffloadManager.__new__(PipelineOffloadManager)
